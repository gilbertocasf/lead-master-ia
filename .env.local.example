# Supabase — credenciais do projeto
# Copie este arquivo para .env.local e preencha com os valores do seu projeto.
# Encontre-os em: Supabase → Project Settings → Data API / API Keys.
#
# Sem estas variáveis, o sistema continua funcionando com dados de exemplo (mock).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key — usado apenas pelo servidor (API routes).
# Nunca usar com prefixo NEXT_PUBLIC_. Encontre em: Supabase → Project Settings → API Keys.
SUPABASE_SERVICE_ROLE_KEY=

# E-mail — notificação ao corretor via Resend (https://resend.com)
# RESEND_API_KEY: chave de API do Resend. Nunca usar NEXT_PUBLIC_.
# EMAIL_FROM: remetente no formato "Nome <email@dominio.com>"
#
# Sem estas variáveis, o sistema funciona normalmente mas não envia e-mails.
RESEND_API_KEY=
EMAIL_FROM=

# Página interna de provisionamento (/admin)
# Lista de e-mails autorizados a criar imobiliárias e o primeiro admin.
# Separados por vírgula. Nunca usar NEXT_PUBLIC_.
# Deixar vazio desabilita a página para todos.
INTERNAL_OWNER_EMAILS=seu-email@exemplo.com

# ─────────────────────────────────────────────────────────────────────
# Integração Meta (Facebook/Instagram Lead Ads) — todas server-side.
# Nunca usar prefixo NEXT_PUBLIC_. Sem elas, o resto do sistema funciona
# normalmente; o webhook responde 503 e a tela /integracoes mostra "pendente".
# ─────────────────────────────────────────────────────────────────────

# App Secret do app da Meta (developers.facebook.com → App → Configurações →
# Básico). Valida a assinatura X-Hub-Signature-256 dos avisos do webhook e
# gera o appsecret_proof das chamadas à Graph API.
META_APP_SECRET=

# Texto livre combinado com o painel da Meta na verificação do webhook
# (Webhooks → Página → "Verificar token"). Use um valor longo e aleatório.
META_VERIFY_TOKEN=

# Token de acesso para ler os leads: token de Usuário do Sistema (Central de
# Negócios) com a permissão leads_retrieval e acesso às Páginas — ou token de
# Página de longa duração. Não fica no banco.
META_ACCESS_TOKEN=

# Opcional. Versão da Graph API (padrão: v25.0).
META_GRAPH_VERSION=

# Protege GET /api/cron/meta. O agendador deve enviar o header
# "Authorization: Bearer <CRON_SECRET>" (a Vercel faz isso nos crons).
# Use um valor longo e aleatório.
CRON_SECRET=

# Destinatários dos alertas operacionais da integração (token expirado, Página
# sem cadastro, formulário sem equipe...), separados por vírgula. Usa
# RESEND_API_KEY e EMAIL_FROM acima. Os alertas não contêm dados de leads.
ALERTA_EMAILS=
